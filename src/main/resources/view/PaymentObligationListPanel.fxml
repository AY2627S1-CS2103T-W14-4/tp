<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>

<fx:root type="javafx.scene.layout.BorderPane" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="5" right="10" bottom="5" left="10" />
  </padding>
  <top>
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Payment obligations" />
  </top>
  <center>
    <ListView fx:id="paymentListView" />
  </center>
  <bottom>
    <Label fx:id="emptyState" wrapText="true" />
  </bottom>
</fx:root>
