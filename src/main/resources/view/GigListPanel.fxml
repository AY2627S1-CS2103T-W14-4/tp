<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<fx:root type="javafx.scene.layout.BorderPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding><Insets top="5" right="10" bottom="5" left="10"/></padding>
  <top><Label text="Gigs" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D3D3D3;"/></top>
  <center><ListView fx:id="gigListView"/></center>
  <bottom><Label fx:id="emptyState" style="-fx-text-fill: #D3D3D3;"/></bottom>
</fx:root>
