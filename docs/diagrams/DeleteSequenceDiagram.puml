@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as logic LOGIC_COLOR
participant ":GigabyteParser" as parser LOGIC_COLOR
participant ":DeleteClientCommandParser" as deleteParser LOGIC_COLOR
participant ":DeleteClientCommand" as command LOGIC_COLOR
end box

[-> logic : execute("delete 1")
activate logic
logic -> parser : parseCommand("delete 1")
activate parser
create deleteParser
parser -> deleteParser : new DeleteClientCommandParser()
activate deleteParser
parser -> deleteParser : parse("1")
create command
deleteParser -> command : new DeleteClientCommand(index)
deleteParser --> parser : command
deactivate deleteParser
parser --> logic : command
deactivate parser
deactivate logic

@enduml
