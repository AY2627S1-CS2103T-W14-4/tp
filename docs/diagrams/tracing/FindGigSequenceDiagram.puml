@startuml
!include ../style.puml
skinparam ArrowFontStyle plain

Actor User as user USER_COLOR
Participant ":MainWindow" as window UI_COLOR
Participant ":LogicManager" as logic LOGIC_COLOR
Participant ":GigabyteParser" as parser LOGIC_COLOR
Participant ":FindGigCommandParser" as findParser LOGIC_COLOR
Participant "command:FindGigCommand" as command LOGIC_COLOR
Participant ":ModelManager" as model MODEL_COLOR
Participant ":GigListPanel" as gigPanel UI_COLOR

user -> window : enter `findgig KEYWORD...`
activate window
window -> logic ++: execute(commandText)
logic -> parser ++: parseCommand(commandText)
create findParser
parser -> findParser : parse(arguments)
create command
findParser -> command ++: keywords
command --> findParser --
findParser --> parser --: command
parser --> logic --: command

logic -> command ++: execute(model)
command -> model ++: getGigList()
model --> command --: gig list
command -> command : count matching gigs
command --> logic --: CommandResult(predicate)
logic --> window --: CommandResult
window -> gigPanel ++: showGigsMatchingTitle(predicate)
gigPanel --> window --
deactivate window

@enduml
