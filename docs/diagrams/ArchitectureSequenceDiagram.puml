@startuml
!include style.puml
skinparam ArrowFontStyle plain

actor User as user USER_COLOR
participant ":UI" as ui UI_COLOR
participant ":Logic" as logic LOGIC_COLOR
participant ":Model" as model MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

user -> ui : enter "delete 1"
activate ui
ui -> logic : execute("delete 1")
activate logic

logic -> model : deleteClient(client)
activate model
model --> logic
deactivate model

logic -> storage : saveGigabyteData(data)
activate storage
storage -> storage : write data to file
storage --> logic
deactivate storage

logic --> ui : CommandResult
deactivate logic
ui --> user : show result
deactivate ui

@enduml
